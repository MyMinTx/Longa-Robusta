# ---------- สวิตช์ ตัวจำลอง ↔ ของจริง ----------
# sim      = ตัวจำลองในเครื่องนี้
# external = ทีมอื่นยิงค่าเข้ามาเองที่ /ingest/* (ใช้ INGEST_KEY)
MOISTURE_SOURCE=sim        # Track 1: sim | external | serial
INSPECTOR=sim              # Track 2: sim | external | camera
MARKET=sim                 # Track 3: sim | external | real

# ---------- ความเร็วตัวจำลอง ----------
MOISTURE_TICK_SECONDS=30   # Track 1 ส่งค่าทุกกี่วินาที
MARKET_ROUND_SECONDS=10    # ตลาดจำลอง 1 รอบกี่วินาที

MOISTURE_TARGET=12.5        # ความชื้นที่ถือว่าแห้งพอขาย (%) ต้องผ่านติดกัน 3 ครั้ง

# ---------- LINE (เว้นว่าง = ไม่ส่ง Push จริง แค่บันทึก log) ----------
LINE_CHANNEL_ACCESS_TOKEN=
LIFF_CHANNEL_ID=           # ว่าง = โหมดพัฒนา ไม่ตรวจ ID token
LIFF_ID=

# ---------- ทั่วไป ----------
PUBLIC_BASE_URL=http://localhost:8000   # URL ที่มือถือเข้าถึงได้ (tunnel) ใช้ทำลิงก์ภาพใน Flex
CORS_ORIGINS=*                          # ตอนใช้จริงใส่โดเมน Vercel
DEMO_KEY=tgr49-demo
INGEST_KEY=tgr49-ingest      # header X-Ingest-Key ของ /ingest/*
DB_PATH=data/tgr49.db
SERIAL_PORT=/dev/ttyUSB0
